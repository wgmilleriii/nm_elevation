{
  "name": "nm-elevation",
  "version": "1.0.0",
  "type": "module",
  "description": "New Mexico elevation data collection",
  "main": "collect_sparse_points.js",
  "scripts": {
    "start": "node collect_sparse_points.js",
    "sync-to-pi": "node sync_to_pi.js",
    "sync-from-pi": "node sync_from_pi.js",
    "test": "node tests/run_gps_tests.cjs",
    "test:gps": "node tests/run_gps_tests.cjs",
    "test:ui": "jest --testEnvironment=jsdom --config=jest.ui.config.cjs"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "better-sqlite3": "^8.7.0",
    "express": "^5.1.0",
    "serialport": "^13.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@jest/globals": "^29.7.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-fetch": "^2.7.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[tj]s?(x)",
      "**/?(*.)+(spec|test).cjs"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(node-fetch)/)"
    ]
  }
}
